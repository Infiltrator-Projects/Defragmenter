[Desktop Entry]
Type=Application
Name=Defragmenter
Comment=Analyse filesystems and create packed or growth-reserved layouts
TryExec=/usr/bin/defragmenter
Exec=/usr/bin/defragmenter
Icon=io.github.defragmenter
Terminal=false
Categories=System;Utility;Filesystem;
Keywords=defrag;defragment;growth;optimise;filesystem;disk;fat;allocation;
StartupNotify=true
StartupWMClass=io.github.defragmenter
